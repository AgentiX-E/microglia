  "datasets": {
    "dev": "BIRD dev",
    "train": "BIRD train (out-of-sample)"
  },
  "gates": [
    {
      "id": "V52-validity-loaded",
      "pass": true,
      "criterion": "both committed artefacts load and carry the registered 1,534 and 7,000 cases",
      "actual": "1534 dev, 7000 train"
    },
    {
      "id": "V53-validity-queries-present",
      "pass": true,
      "criterion": "no case is missing a query it claims to have answered — a missing bare query must come with a bare arm recorded wrong, and a missing served query with a parse failure",
      "actual": "0 dev and 10 train bare, 0 dev and 2 train served, none of them recorded as answered"
    },
    {
      "id": "V54-validity-rules-reported",
      "pass": true,
      "criterion": "both grounding rules are read on both arms of both splits, so the rule cannot be chosen after the fact",
      "actual": "strict and morphological, on bare and served, on dev and train"
    }
  ],
  "verdicts": [
    {
      "id": "P1",
      "claim": "both corpora load at the registered sizes, and every missing query is one the run already records as a failure",
      "observed": "7000 train (10 bare, 2 served), 1534 dev (0 bare, 0 served)",
      "holds": true
    },
    {
      "id": "P2",
      "claim": "the strict rule flags at least 60.0% of bare attempts and the loose rule 40.0%",
      "observed": "94.8% strict, 75.8% morphological",
      "holds": true
    },
    {
      "id": "P3",
      "claim": "flagged bare attempts are at least 5pp less accurate, on an interval that excludes zero",
      "observed": "-12.58pp [-22.15pp, -2.92pp], excludes zero",
      "holds": true
    },
    {
      "id": "P4",
      "claim": "dev's gap has the same sign and is within 4pp of train's",
      "observed": "-21.70pp against -12.58pp",
      "holds": false
    },
    {
      "id": "P5",
      "claim": "the question-only check clears the memory filter's Youden of 0.1068 on both splits",
      "observed": "0.0257 train, 0.0556 dev",
      "holds": false
    },
    {
      "id": "P6",
      "claim": "the served query is flagged at least 5.0% more often than the bare one",
      "observed": "0.42pp",
      "holds": false
    }
  ],
