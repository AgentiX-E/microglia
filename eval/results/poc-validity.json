  "id": "poc-validity",
  "title": "Whether the read-time filter survives without a baseline to anchor on",
  "registered": "prereg/R33.md",
  "sources": {
    "dev": "eval/results/poc-sota-bird-dev-R26-channels.json",
    "train": "eval/results/poc-sota-bird-train.json"
