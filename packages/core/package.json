{
  "name": "@agentix-e/microglia-core",
  "version": "0.1.0",
  "description": "Microglia core \u2014 feedback, correction, and knowledge contracts with zero I/O",
  "license": "MIT",
  "author": "Lambertyan",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "default": "./dist/kernel/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./dist/memory/index.js"
    },
    "./distill": {
      "types": "./dist/distill/index.d.ts",
      "default": "./dist/distill/index.js"
    },
    "./apply": {
      "types": "./dist/apply/index.d.ts",
      "default": "./dist/apply/index.js"
    },
    "./capture": {
      "types": "./dist/capture/index.d.ts",
      "default": "./dist/capture/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "import": "./dist/delivery/index.js",
      "default": "./dist/delivery/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {},
  "devDependencies": {},
  "engines": {
    "node": ">=20.11.0"
  }
}
