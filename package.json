{
  "name": "microglia",
  "version": "0.1.0",
  "private": true,
  "description": "Microglia \u2014 a headless feedback flywheel SDK for agentic workflows",
  "license": "MIT",
  "author": "Lambertyan",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/microglia.git"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc -b packages/core packages/eval packages/node packages/browser",
    "clean": "tsc -b --clean packages/core packages/eval packages/node packages/browser",
    "typecheck": "tsc -b packages/core packages/eval packages/node packages/browser",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "bench": "pnpm build && node packages/eval/dist/bench/run.js",
    "check": "pnpm typecheck && pnpm poc:typecheck && pnpm test && pnpm audit:repo && pnpm poc:integrity && pnpm bench",
    "poc:llm-reader": "tsx poc/llm-reader.ts",
    "poc:llm-distill": "tsx poc/llm-distill.ts",
    "poc:embedding": "tsx poc/embedding.ts",
    "poc:scale": "tsx poc/scale.ts",
    "poc:live": "pnpm poc:llm-reader && pnpm poc:llm-distill && pnpm poc:embedding && pnpm poc:scale",
    "poc:sota": "tsx poc/sota-bird.ts",
    "poc:integrity": "tsx poc/integrity.ts",
    "poc:cortex": "node scripts/cortex-conformance.mjs",
    "audit:deps": "pnpm audit --prod",
    "audit:repo": "node scripts/audit.mjs",
    "poc:typecheck": "tsc --noEmit --target es2022 --module nodenext --moduleResolution nodenext --skipLibCheck poc/*.ts",
    "poc:attribute": "tsx poc/attribute.ts"
  },
  "devDependencies": {
    "@agentix-e/microglia-core": "workspace:*",
    "@agentix-e/microglia-eval": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7",
    "@agentix-e/microglia-node": "workspace:*",
    "@agentix-e/microglia-browser": "workspace:*"
  }
}
