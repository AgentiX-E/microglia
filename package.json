{
  "name": "microglia",
  "version": "0.1.0",
  "private": true,
  "description": "Microglia \u2014 a headless feedback flywheel SDK for agentic workflows",
  "license": "MIT",
  "author": "Lambertyan",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/microglia.git"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc -b packages/core packages/protocol packages/sql packages/eval packages/node packages/browser",
    "clean": "tsc -b --clean packages/core packages/protocol packages/sql packages/eval packages/node packages/browser",
    "typecheck": "tsc -b packages/core packages/protocol packages/sql packages/eval packages/node packages/browser",
    "typecheck:lanes": "tsc --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext --skipLibCheck packages/eval/src/bin/*.ts",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "bench": "pnpm build && node packages/eval/dist/bench/run.js",
    "check": "pnpm typecheck && pnpm typecheck:lanes && pnpm test && pnpm audit:repo && pnpm eval:power && pnpm eval:integrity && pnpm eval:memform && pnpm eval:l0 && pnpm eval:pairs && pnpm eval:delivery && pnpm eval:protocol && pnpm eval:query-diff && pnpm eval:mediation && pnpm eval:stability && pnpm eval:feature-overlap && pnpm eval:rule-form && pnpm eval:referent && pnpm eval:out-of-sample && pnpm eval:validity && pnpm eval:admission && pnpm eval:ledger && pnpm eval:pack-assign && pnpm eval:lexicon && pnpm eval:frontier && pnpm eval:resolution && pnpm eval:coupling && pnpm eval:verifiers && pnpm bench && pnpm bundle:size",
    "eval:llm-reader": "tsx packages/eval/src/bin/llm-reader.ts",
    "eval:llm-distill": "tsx packages/eval/src/bin/llm-distill.ts",
    "eval:embedding": "tsx packages/eval/src/bin/embedding.ts",
    "eval:scale": "tsx packages/eval/src/bin/scale.ts",
    "eval:live": "pnpm eval:llm-reader && pnpm eval:llm-distill && pnpm eval:embedding && pnpm eval:scale",
    "eval:sota": "tsx packages/eval/src/bin/sota-bird.ts",
    "eval:integrity": "tsx packages/eval/src/bin/integrity.ts",
    "eval:memform": "tsx packages/eval/src/bin/memform.ts",
    "eval:l0": "tsx packages/eval/src/bin/l0.ts",
    "eval:pairs": "tsx packages/eval/src/bin/pairs.ts",
    "eval:delivery": "tsx packages/eval/src/bin/delivery.ts",
    "eval:l4": "tsx packages/eval/src/bin/l4.ts",
    "eval:judge": "tsx packages/eval/src/bin/judge-calibrate.ts",
    "eval:adjudicate": "tsx packages/eval/src/bin/sota-adjudicate.ts",
    "eval:cortex": "node scripts/cortex-conformance.mjs",
    "audit:deps": "pnpm audit --prod",
    "audit:repo": "node scripts/audit.mjs",
    "bundle:size": "node scripts/bundle-size.mjs",
    "eval:attribute": "tsx packages/eval/src/bin/attribute.ts",
    "eval:pool": "tsx packages/eval/src/bin/pool.ts",
    "eval:signals": "tsx packages/eval/src/bin/signals.ts",
    "eval:prior": "tsx packages/eval/src/bin/prior.ts",
    "eval:density": "tsx packages/eval/src/bin/density.ts",
    "eval:template": "tsx packages/eval/src/bin/template-probe.ts",
    "eval:union": "tsx packages/eval/src/bin/union.ts",
    "eval:store": "tsx packages/eval/src/bin/store.ts",
    "eval:arm-pairs": "tsx packages/eval/src/bin/arm-pairs.ts",
    "eval:arm-contrast": "tsx packages/eval/src/bin/arm-contrast.ts",
    "eval:l4-pair": "tsx packages/eval/src/bin/l4-pair.ts",
    "eval:label-census": "tsx packages/eval/src/bin/label-census.ts",
    "eval:probe": "tsx packages/eval/src/bin/embed-probe.ts",
    "eval:plugin": "tsx packages/eval/src/bin/plugin-run.ts",
    "eval:prereg": "tsx packages/eval/src/bin/prereg.ts",
    "eval:prereg-floor": "tsx packages/eval/src/bin/prereg-floor.ts",
    "eval:prereg-pair": "tsx packages/eval/src/bin/prereg-pair.ts",
    "eval:verifiers": "python3 eval/verifiers/r49_readback.py --self-test",
    "eval:facade-pair-readback": "tsx packages/eval/src/bin/facade-pair-readback.ts",
    "eval:protocol": "tsx packages/eval/src/bin/protocol.ts",
    "eval:harm": "tsx packages/eval/src/bin/harm-strata.ts",
    "eval:power": "tsx packages/eval/src/bin/power-audit.ts",
    "eval:query-diff": "tsx packages/eval/src/bin/query-diff.ts",
    "eval:split-precheck": "tsx packages/eval/src/bin/split-precheck.ts",
    "eval:feature-overlap": "tsx packages/eval/src/bin/feature-overlap.ts",
    "eval:rule-form": "tsx packages/eval/src/bin/rule-form.ts",
    "eval:referent": "tsx packages/eval/src/bin/referent.ts",
    "eval:out-of-sample": "tsx packages/eval/src/bin/out-of-sample.ts",
    "eval:validity": "tsx packages/eval/src/bin/validity.ts",
    "eval:admission": "tsx packages/eval/src/bin/admission.ts",
    "eval:ledger": "tsx packages/eval/src/bin/ledger.ts",
    "eval:pack-assign": "tsx packages/eval/src/bin/pack-assign.ts",
    "eval:lexicon": "tsx packages/eval/src/bin/lexicon.ts",
    "eval:frontier": "tsx packages/eval/src/bin/frontier.ts",
    "eval:resolution": "tsx packages/eval/src/bin/resolution.ts",
    "eval:coupling": "tsx packages/eval/src/bin/coupling.ts",
    "eval:mediation": "tsx packages/eval/src/bin/mediation.ts",
    "eval:stability": "tsx packages/eval/src/bin/gate-stability.ts"
  },
  "devDependencies": {
    "@agentix-e/microglia-browser": "workspace:*",
    "@agentix-e/microglia-core": "workspace:*",
    "@agentix-e/microglia-eval": "workspace:*",
    "@agentix-e/microglia-node": "workspace:*",
    "@agentix-e/microglia-sql": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
